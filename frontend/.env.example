# ClimateTwin AI Frontend Environment Template
# Copy this file to .env or .env.local and configure your settings

# Base URL for backend API (Default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Google Maps JavaScript API Key (Optional: Leaflet fallback activates automatically if omitted)
# Enable Maps JavaScript API in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=
