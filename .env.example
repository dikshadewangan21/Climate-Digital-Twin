# ──────────────────────────────────────────────────────────────
# ClimateTwin AI — Production Environment Configuration Template
# ──────────────────────────────────────────────────────────────

# --- Frontend Environment Variables (Prefix with VITE_) ---
# The URL of the running backend API server
VITE_API_BASE_URL=http://localhost:8000

# Google Maps JavaScript API Key (Optional: Leaflet fallback activates automatically if omitted)
# Enable Maps JavaScript API in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=

# --- Backend Environment Variables (backend) ---
# Port the uvicorn server listens on
PORT=8000

# Allowed CORS Origins (comma-separated or * for public access)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment Mode (production / development)
ENVIRONMENT=production
