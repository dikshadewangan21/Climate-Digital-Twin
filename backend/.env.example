# ──────────────────────────────────────────────────────────────
# ClimateTwin AI — Backend Environment Configuration
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────
# Port the uvicorn server listens on (default: 8000)
PORT=8000

# ──────────────────────────────────────────────────────────────
# CORS — Frontend Origins
# Add your production frontend URL if deploying publicly.
# ──────────────────────────────────────────────────────────────
# FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# ──────────────────────────────────────────────────────────────
# External API
# ──────────────────────────────────────────────────────────────
# Open-Meteo is used for live weather and ERA5-Land historical data.
# No API key is required — it is a free public API.
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# ──────────────────────────────────────────────────────────────
# ML Model Paths (relative to backend root)
# ──────────────────────────────────────────────────────────────
# These paths are resolved automatically. Override only if you
# move the model files to a custom location.
# MODEL_V2_PATH=saved_models_v2/climate_lstm_best.pth
# FEATURE_SCALER_PATH=datasets/processed/v2/feature_scaler.pkl
# TARGET_SCALER_PATH=datasets/processed/v2/target_scaler.pkl

# ──────────────────────────────────────────────────────────────
# NOTE: No secrets or API keys are required by this backend.
# All climate data is sourced from the free Open-Meteo API.
# ──────────────────────────────────────────────────────────────
